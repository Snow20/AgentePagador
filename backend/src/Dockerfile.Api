FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY src/Agent.Api/Agent.Api.csproj Agent.Api/
COPY src/Agent.Core/Agent.Core.csproj Agent.Core/
COPY src/Agent.Infrastructure/Agent.Infrastructure.csproj Agent.Infrastructure/

RUN dotnet restore Agent.Api/Agent.Api.csproj

COPY src/Agent.Api/ Agent.Api/
COPY src/Agent.Core/ Agent.Core/
COPY src/Agent.Infrastructure/ Agent.Infrastructure/

WORKDIR /src/Agent.Api
RUN dotnet publish -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .

EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080

ENTRYPOINT ["dotnet", "Agent.Api.dll"]